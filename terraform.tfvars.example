# Sao chép thành terraform.tfvars và chỉnh theo account đang triển khai.
# (terraform.tfvars không được commit)

# vpc_id     = "vpc-0a7f2229b36e6ceb5"
# subnet_ids = ["subnet-01e7b81b2c34fbaae", "subnet-0729b4d3570c85035", "subnet-063d005e791e4932f"]

# Admin cụm EKS ngoài người chạy Terraform (root, IAM user hoặc role)
# cluster_admin_arns = ["arn:aws:iam::609320954321:root"]

# Version chart GitLab (helm search repo gitlab/gitlab --versions)
# gitlab_chart_version = "9.11.16"

# domain                    = "gitlabonlinecom.click"
# manage_domain_nameservers = true

# Bật sau khi ALB đã được tạo (lượt apply thứ 2)
# enable_dns_records = true
